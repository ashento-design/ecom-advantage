{
  "manifest_version": 3,
  "name": "Launchory — Product Research",
  "short_name": "Launchory",
  "version": "1.0.0",
  "description": "Analyze any AliExpress product instantly with Launchory AI — get demand scores, ad angles, hooks, and pricing in seconds.",
  "homepage_url": "https://launchory.io",
  "author": "Launchory",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.aliexpress.com/*",
    "https://aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://www.aliexpress.us/*",
    "https://aliexpress.us/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": [
      "https://www.aliexpress.com/*",
      "https://aliexpress.com/*",
      "https://*.aliexpress.com/*",
      "https://www.aliexpress.us/*",
      "https://aliexpress.us/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
