{
  "manifest_version": 3,
  "name": "Launchory — Product Research",
  "version": "1.0.0",
  "description": "Analyze any AliExpress product instantly with Launchory AI",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://*.aliexpress.com/item/*"],
    "js": ["content.js"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
